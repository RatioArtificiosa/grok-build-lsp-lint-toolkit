{
  "clangd": {
    "command": "node",
    "args": [
      "@PROXY@",
      "clangd"
    ],
    "extensionToLanguage": {
      ".c": "c",
      ".h": "c",
      ".cc": "cpp",
      ".cpp": "cpp",
      ".cxx": "cpp",
      ".hpp": "cpp",
      ".hxx": "cpp",
      ".hh": "cpp",
      ".C": "cpp",
      ".H": "cpp",
      ".cppm": "cpp",
      ".ixx": "cpp"
    },
    "startupTimeout": 30000
  }
}
