# Line endings are pinned, not guessed.
#
# `.cmd` scripts are executed by cmd.exe, which requires CRLF. `.sh` scripts are
# executed by a POSIX shell, which breaks on a stray CR. Committing from one
# platform and cloning on another must not change either, so both are pinned
# explicitly rather than left to core.autocrlf.
* text=auto eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.sh   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf